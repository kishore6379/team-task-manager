{
  "name": "team-task-manager",
  "version": "1.0.0",
  "description": "Full-stack team task manager with projects, tasks, dashboard, and role-based access.",
  "keywords": [
    "task-manager",
    "express",
    "prisma",
    "railway"
  ],
  "license": "MIT",
  "author": "kishore",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently \"nodemon src/server.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "nodemon src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
